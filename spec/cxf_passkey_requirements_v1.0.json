    {"id":"CXF-HMAC-004","section":"3.3.12.3","level":"SHOULD","actor":"document","text":"UV and non-UV HMAC credentials are 32 bytes.","verification":"automated","tests":["test_cxf_validator_warns_on_nonrecommended_hmac_length"]},
    {"id":"CXF-HMAC-005","section":"3.3.12.3","level":"SHOULD","actor":"importer","text":"Ignore an HMAC entry using an unknown algorithm.","verification":"automated-profile","tests":["test_cxf_import_ignores_unknown_hmac_algorithm"]},
    {"id":"CXF-LB-001","section":"3.3.12.5","level":"MUST","actor":"document","text":"largeBlob contains uncompressedSize and DEFLATE-compressed data.","verification":"automated","tests":["test_cxf_large_blob_is_deflate_compressed_and_round_trips"]},
    {"id":"CXF-OPT-001","section":"3.3.12.2","level":"MUST","actor":"document","text":"credBlob, when present, is base64url-encoded bytes.","verification":"automated","tests":["test_cxf_profile_round_trip_preserves_known_values"]},
    {"id":"CXF-OPT-002","section":"3.3.12.2","level":"MUST","actor":"document","text":"payments, when present, is boolean.","verification":"automated","tests":["test_cxf_validator_rejects_nonboolean_payments"]}
